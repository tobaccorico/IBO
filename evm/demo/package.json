{
  "name": "truth-or-dare-markets",
  "version": "1.0.0",
  "description": "Truth or Dare prediction markets on Ethereum",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy:contracts": "forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast",
    "verify:contracts": "forge verify-contract --chain-id $CHAIN_ID"
  },
  "dependencies": {
    "@metamask/sdk": "^0.20.5",
    "buffer": "^6.0.3",
    "ethers": "^6.15.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@metamask/providers": "^22.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.1.6"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "react-scripts": {
      "webpack": {
        "buffer": "buffer",
        "process": "process/browser"
      }
    }
  }
}
